+        id: set-use-cache
+        shell: bash
+        run: |
+          set -x
+          use_cache=$(cat ${GITHUB_WORKSPACE}/.github/config/${{ inputs.platform }}.json | jq -rc 'if .use_cache != null then .use_cache else true end')
